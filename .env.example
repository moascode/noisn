# Camunda 8 Cloud — REST API (used by the Session Broker)
CAMUNDA_REST_URL=https://<cluster-id>.zeebe.camunda.io
CAMUNDA_REST_TOKEN=<your-camunda-rest-token>
PROCESS_DEFINITION_KEY=pension-configurator

# Camunda 8 Cloud — Zeebe gRPC (used by job workers)
ZEEBE_ADDRESS=<cluster-id>.zeebe.camunda.io:443
ZEEBE_CLIENT_ID=<your-client-id>
ZEEBE_CLIENT_SECRET=<your-client-secret>

# Session Broker internal security
# Workers must send this value in the X-Internal-Api-Key header to POST /internal/send
BROKER_INTERNAL_API_KEY=<generate-a-random-secret-min-32-chars>

# Allowed WebSocket origins (comma-separated, no trailing slash)
BROKER_ALLOWED_ORIGINS=https://your-ui-domain.example.com

# AWS — Bedrock Knowledge Base queries (used by search-kb worker)
# Prefer IAM roles in production; only set these in local dev / CI
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=<your-aws-access-key-id>
AWS_SECRET_ACCESS_KEY=<your-aws-secret-access-key>
BEDROCK_KB_ID=<your-bedrock-knowledge-base-id>

# AWS credentials for the AI Agent Connector (LLM calls) are configured as
# Camunda secrets (secrets.AWS_ACCESS_KEY_ID / secrets.AWS_SECRET_ACCESS_KEY),
# NOT as environment variables here.

# React UI build-time variable
VITE_BROKER_WS_URL=wss://your-broker-domain.example.com
