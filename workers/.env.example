# ─── CAMUNDA ──────────────────────────────────────────────────────────────────

# Zeebe gRPC endpoint for your Camunda 8 cluster
# Format: <cluster-id>.zeebe.camunda.io:443  (SaaS)
#      or host:26500                          (self-managed)
ZEEBE_ADDRESS=

# OAuth client credentials — created in Camunda Console under API > Client
ZEEBE_CLIENT_ID=
ZEEBE_CLIENT_SECRET=

# Camunda REST API base URL (used for variable read/write outside of job workers)
# SaaS:         https://<region>.operate.camunda.io/<cluster-id>
# Self-managed: http://localhost:8080
CAMUNDA_REST_URL=

# Bearer token for the Camunda REST API
CAMUNDA_REST_TOKEN=


# ─── AWS ──────────────────────────────────────────────────────────────────────

# AWS region where Bedrock and other services are deployed
AWS_REGION=eu-west-1

# IAM credentials — use an IAM role (recommended) or static keys
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=          # only needed when using temporary STS credentials


# ─── BEDROCK ──────────────────────────────────────────────────────────────────

# Claude model ID used for LLM inference via the Bedrock Converse API
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Embedding model used to vectorise the query before OpenSearch k-NN search.
# MUST match the model that was used to embed documents at index time.
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0


# ─── OPENSEARCH ───────────────────────────────────────────────────────────────

# Full URL of the OpenSearch cluster including scheme and port
# Example: https://opensearch.internal.example.com:9200
OPENSEARCH_URL=

# Name of the index that contains the pension knowledge base documents
OPENSEARCH_INDEX=pension-kb

# Basic auth credentials — leave blank if the cluster is unauthenticated (VPC-internal)
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=

# Name of the k-NN vector field in the index.
# Ask infra: what field was used to store document embeddings at index time?
OPENSEARCH_VECTOR_FIELD=embedding

# Name of the field that holds the raw passage text returned in search hits.
# Ask infra: what field contains the human-readable document content?
OPENSEARCH_TEXT_FIELD=text


# ─── INTERNAL SERVICES ────────────────────────────────────────────────────────

# Base URL of the FastAPI pension calculator service
# Default assumes it runs locally alongside the workers
CALCULATOR_API_URL=http://localhost:8001
